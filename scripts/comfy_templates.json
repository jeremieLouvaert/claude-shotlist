   "ver": "9b565354e32a7061296ac598d9c7f445e10d31ed",
   "Node name for S&R": "StringConstantMultiline"
  },
  "widgets_values": [
   ""
  ],
  "widgets_values_named": {
   "string": "Fixed static camera, no camera movement, locked-off shot. Black-and-white 1950s\nfilm, fine silver-gelatin grain, soft venetian-blind light from the left, deep\ncharcoal shadows, full tonal range. A silver-haired man in a black suit sits behind\nthe desk looking straight into the lens, his face perfectly still and composed while\nhis fingers move fast and steady across the typewriter keys, striking key after key,\nactively typing a full page with practiced speed. After a few seconds of this\nrelentless typing, his left-side hand lifts to the chrome carriage-return lever at\nthe left end of the carriage and sweeps it sideways in one short firm motion; the\ncarriage snaps back across the typewriter. The white sheet in the platen is carried\nloose and drops forward onto the desk, falling with real weight and gravity like an\nactual sheet of paper, tipping and fluttering as it slices down through the air,\nnever floating, never rising. His hands immediately return to the keys and keep\ntyping. Calm face, busy hands, restrained and elegant, real motion.",
   "strip_newlines": true
  }
 },
